# 이 파일을 복사해서 .env로 만들고 실제 값을 채워 넣으세요.
# .env는 절대 커밋하지 마세요 (.gitignore에 등록되어 있음).

# ── LLM: 둘 중 하나만 채우면 됨 ──────────────────────────────────────────────
# (A) Google AI Studio 방식 — GEMINI_API_KEY만 채우면 됨
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (B) VertexAI 방식 — GEMINI_API_KEY는 비워두고 아래 3개를 채움
#     MobiOps에서 "KM VertexAI Writer" 권한 신청 후 받는 서비스 계정 키 JSON 파일 경로
#     (JSON 파일 자체는 커밋 금지 — 예: server/vertex-service-account.json 으로 저장 후 아래에 경로만 지정)
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# 사용할 모델 (Gemini Flash)
GEMINI_MODEL=gemini-2.0-flash

# 사내 Confluence 주소
CONFLUENCE_BASE_URL=https://wiki.daumkakao.com

# Confluence Personal Access Token
# 발급 경로: {CONFLUENCE_BASE_URL}/plugins/personalaccesstokens/usertokens.action
CONFLUENCE_PAT=

# AI가 참고할 문서의 루트 페이지ID (이 페이지 + 하위 전체 트리를 재귀적으로 수집해서 답변에 사용)
# 현재값 = "Proj. 정산 개편" (https://wiki.daumkakao.com/spaces/KMYARD/pages/2050867193)
CONFLUENCE_ROOT_PAGE_ID=2050867193

# 하위 트리 전체를 매번 크롤링하면 느리므로, 서버 메모리에 이 시간(분) 동안 캐싱 후 재사용
CONFLUENCE_CACHE_MINUTES=5

# Slack App(Incoming Webhooks)에서 발급 (https://api.slack.com/apps)
SLACK_WEBHOOK_URL=

# 백엔드 서버 포트
PORT=8787
